rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Default-deny catch-all (Global Safety Net)
    match /{document=**} {
      allow read, write: if false;
    }

    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    function isValidId(id) {
      return id is string && id.size() > 0 && id.size() <= 128;
    }

    // User profile documents - isolados por usuário
    match /users/{userId} {
      allow get, list: if isOwner(userId);
      allow create, update: if isOwner(userId);
      allow delete: if false;

      // Transactions subcollection privada de cada cliente
      match /transactions/{transactionId} {
        allow get, list: if isOwner(userId);
        allow create, update: if isOwner(userId) && isValidId(transactionId);
        allow delete: if isOwner(userId) && isValidId(transactionId);
      }
    }
  }
}
